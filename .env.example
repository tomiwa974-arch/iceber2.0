# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
# Demo by default. Enable only after configuring a real operator and reviewing policies.
RESTAURANT_LIVE=false
# Set only after verifying your host proxy. Empty ignores forwarded IP headers.
# Exact proxy IP/CIDR (or a verified hop count); configure only one of these.
TRUSTED_PROXY=
# TRUSTED_PROXY_HOPS=1
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=iceberg

# Laptop push alerts: generate once with `npx web-push generate-vapid-keys`
# Keep the private key secret and preserve these keys across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Server-only Paystack secret key. Start with sk_test_...; never expose this in VITE_*.
PAYSTACK_SECRET_KEY=

# Transactional booking confirmations (server-only credentials)
RESEND_API_KEY=
BOOKING_EMAIL_FROM=
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=

# Optional Stripe hosted checkout (server-only). Keep Paystack settings to offer both.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Enable after checking the production browser console for CSP violations.
CSP_ENFORCE=false
